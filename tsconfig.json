{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "jsx": "preserve",
        "strict": false,
        "noImplicitAny": false,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "useDefineForClassFields": true,
        "sourceMap": true,
        "noEmit": true,
        "types": ["vite/client", "node"],
        "baseUrl": ".",
        "paths": {
            "@/*": ["./*"],
            "~/*": ["./*"],
            "~~/*": ["./*"],
            "@@/*": ["./*"]
        }
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.d.ts",
        "src/**/*.vue",
        "pages/**/*.vue",
        "components/**/*.vue",
        "components/**/*.ts",
        "layouts/**/*.vue",
        "stores/**/*.ts",
        "composables/**/*.ts",
        "utils/**/*.ts",
        "api/**/*.ts",
        "constants/**/*.ts",
        "enums/**/*.ts",
        "typings/**/*.d.ts",
        "global.d.ts",
        "vite.config.ts"
    ],
    "exclude": ["node_modules", "dist", ".output", ".nuxt"]
}
